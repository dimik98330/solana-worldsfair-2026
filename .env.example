# Localnet or devnet only. No secrets or user wallet keys.
BONDTRACE_NETWORK=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
BONDTRACE_PROGRAM_ID=B3aFCQ25iN3gjmvznAaY5RNnnw8J5ihFPsPoGgWXhmb8
BONDTRACE_ENABLE_DEMO=true
PORT=3000
# Optional built UI directory inside this workspace; unset uses apps/web/dist.
# Pin a validated immutable build when another developer is rebuilding the UI.
# BONDTRACE_WEB_DIST=.local/releases/ui/current
# Optional local PostgreSQL (default local SQLite needs no external database).
# BONDTRACE_STORAGE_BACKEND=postgres
# BONDTRACE_DATABASE_NAMESPACE=bondtrace-localnet
# DATABASE_URL=<server-only value supplied securely; never commit credentials>
# BONDTRACE_DATABASE_TLS=verify-full
# local-only TLS exception is restricted to explicit loopback localnet tests.
# Hosted settings and owner-assisted Render/Neon setup: docs/31-HOSTING.md

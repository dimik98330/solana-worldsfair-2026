  "components": [
    {
      "name": "Primary command",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Available operation command; labels carry actual task names.",
      "html": "<button class=\"ds-primary\">Review action<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:9px 16px;border:1px solid var(--border-control,#61748e);border-radius:8px;font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:15px;font-weight:650;line-height:1.45;cursor:pointer}.ds-primary:focus-visible{outline:3px solid var(--primary,#376cf4);outline-offset:3px}.ds-primary:active:not(:disabled){filter:brightness(.96)}.ds-primary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:color 140ms cubic-bezier(.16,1,.3,1),background-color 140ms cubic-bezier(.16,1,.3,1),border-color 140ms cubic-bezier(.16,1,.3,1)}}.ds-primary{background:var(--primary,#376cf4);border-color:var(--primary,#376cf4);color:var(--primary-foreground,#ffffff)}.ds-primary:hover:not(:disabled){background:var(--primary-hover,#2c5edd);border-color:var(--primary-hover,#2c5edd)}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting working action without command-blue fill.",
      "html": "<button class=\"ds-secondary\">View receipts<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:9px 16px;border:1px solid var(--border-control,#61748e);border-radius:8px;font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:15px;font-weight:650;line-height:1.45;cursor:pointer}.ds-secondary:focus-visible{outline:3px solid var(--primary,#376cf4);outline-offset:3px}.ds-secondary:active:not(:disabled){filter:brightness(.96)}.ds-secondary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:no-preference){.ds-secondary{transition:color 140ms cubic-bezier(.16,1,.3,1),background-color 140ms cubic-bezier(.16,1,.3,1),border-color 140ms cubic-bezier(.16,1,.3,1)}}.ds-secondary{background:var(--panel,#161e2b);color:var(--foreground,#eef2f8)}.ds-secondary:hover:not(:disabled){background:var(--panel-subtle,#1c2737);border-color:var(--muted,#a6b3c6)}"
    },
    {
      "name": "Ghost action",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Local detail or supporting link inside a working record.",
      "html": "<button class=\"ds-ghost\">Details<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:9px 16px;border:1px solid var(--border-control,#61748e);border-radius:8px;font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:15px;font-weight:650;line-height:1.45;cursor:pointer}.ds-ghost:focus-visible{outline:3px solid var(--primary,#376cf4);outline-offset:3px}.ds-ghost:active:not(:disabled){filter:brightness(.96)}.ds-ghost:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:no-preference){.ds-ghost{transition:color 140ms cubic-bezier(.16,1,.3,1),background-color 140ms cubic-bezier(.16,1,.3,1),border-color 140ms cubic-bezier(.16,1,.3,1)}}.ds-ghost{background:transparent;border-color:transparent;color:var(--muted,#a6b3c6)}.ds-ghost:hover:not(:disabled){background:var(--primary-soft,#1d3053);color:var(--link,#9fc0ff)}"
    },
    {
      "name": "Inset numeric field",
      "kind": "input",
      "refersTo": "issuer-input",
      "description": "Exact decimal-safe input with one merged focus edge; validation begins on blur/progression.",
      "html": "<label class=\"ds-field\">Face value<input type=\"text\" inputmode=\"decimal\" value=\"1000\" autocomplete=\"off\"></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--foreground,#eef2f8);font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:16px;font-weight:600;line-height:1.5}.ds-field input{width:100%;min-height:56px;padding:12px 16px;border:1px solid var(--border-control,#61748e);border-radius:8px;background:var(--input,#0d1420);color:var(--foreground,#eef2f8);font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:18px;font-weight:600;line-height:1.5;letter-spacing:-.015em;font-variant-numeric:tabular-nums lining-nums;font-feature-settings:'tnum'}.ds-field input:hover:not(:disabled):not([aria-invalid=true]){border-color:var(--muted,#a6b3c6)}.ds-field input:focus-visible{border-color:var(--link,#9fc0ff);outline:1px solid var(--link,#9fc0ff);outline-offset:-1px;box-shadow:none}.ds-field input[aria-invalid=true]{border-color:var(--error,#efadb5)}.ds-field input:disabled{background:var(--background,#0f1520);color:var(--muted,#a6b3c6)}@media(prefers-reduced-motion:no-preference){.ds-field input{transition:border-color 150ms cubic-bezier(.16,1,.3,1)}}"
    },
    {
      "name": "Selected navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "One active work view, with clear labeled icon and quiet selected seam.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Work views\"><button aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 8V5a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h15v10a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V6\"/><path d=\"M20 12h-4a2 2 0 0 0 0 4h4\"/></svg>Payments<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button></nav>",
      "css": ".ds-nav{padding:16px;background:var(--nav,#0a101a)}.ds-nav button{display:flex;align-items:center;gap:12px;width:100%;min-height:48px;padding:12px;border:1px solid var(--nav-border,#233044);border-radius:8px;background:var(--nav-active,#182b49);color:#c3d7ff;font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:16px;font-weight:650;text-align:left;cursor:pointer}.ds-nav button svg:first-child{color:var(--link,#9fc0ff)}.ds-nav button svg:last-child{margin-left:auto}.ds-nav button:hover{background:var(--nav-active,#182b49);color:#c3d7ff}.ds-nav button:focus-visible{outline:3px solid #93b9ff;outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ds-nav button{transition:color 140ms cubic-bezier(.16,1,.3,1),background-color 140ms cubic-bezier(.16,1,.3,1),border-color 140ms cubic-bezier(.16,1,.3,1)}}"
    },
    {
      "name": "Paid status",
      "kind": "chip",
      "refersTo": "badge-success",
      "description": "Textual state; specimen appearance is not transaction evidence.",
      "html": "<span class=\"ds-paid\">Paid</span>",
      "css": ".ds-paid{display:inline-flex;align-items:center;min-height:26px;padding:4px 8px;border-radius:5px;background:var(--success-soft,#253c37);color:var(--success,#9cd2be);font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:13px;font-weight:600;line-height:1.5}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Tonal record/form container; child sections supply spacing, no ambient card shadow.",
      "html": "<section class=\"ds-panel\"><h2>Issue terms</h2><p>Exact terms remain available in review.</p></section>",
      "css": ".ds-panel{padding:24px;border:1px solid var(--border,#2c3a4f);border-radius:14px;background:var(--panel,#161e2b);color:var(--foreground,#eef2f8);font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);line-height:1.55}.ds-panel h2{margin:0;font-size:18px;font-weight:650}.ds-panel p{margin:12px 0 0;color:var(--muted,#a6b3c6);font-size:16px}"
    },
    {
      "name": "Protected date trigger",
      "kind": "custom",
      "refersTo": "date-trigger",
      "description": "Inset date/time trigger; runtime protected calendar is at most 440px with viewport margins, persistent Save/Cancel and unchanged canonical instants until Save.",
      "html": "<button class=\"ds-date\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18\"/></svg><span>Choose date<small>Time and timezone</small></span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-date{display:flex;align-items:center;gap:12px;width:100%;min-height:76px;padding:12px 16px;border:1px solid var(--border-control,#61748e);border-radius:8px;background:var(--input,#0d1420);color:var(--foreground,#eef2f8);font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:17px;font-weight:600;text-align:left;font-variant-numeric:tabular-nums;cursor:pointer}.ds-date>span{display:grid;gap:4px;min-width:0}.ds-date small{color:var(--muted,#a6b3c6);font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:16px;font-weight:400}.ds-date>svg{color:var(--muted,#a6b3c6)}.ds-date>svg:first-child{color:var(--link,#9fc0ff)}.ds-date>svg:last-child{margin-left:auto}.ds-date:hover:not(:disabled){border-color:var(--muted,#a6b3c6)}.ds-date:focus-visible{border-color:var(--link,#9fc0ff);outline:1px solid var(--link,#9fc0ff);outline-offset:-1px;box-shadow:none}.ds-date:disabled{color:var(--muted,#a6b3c6);background:var(--background,#0f1520);cursor:not-allowed}@media(prefers-reduced-motion:no-preference){.ds-date{transition:background-color 150ms cubic-bezier(.16,1,.3,1),border-color 150ms cubic-bezier(.16,1,.3,1),color 150ms cubic-bezier(.16,1,.3,1)}}"
    },
    {
      "name": "Payment search",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Real holder name/address filter; no-match remains separate from no recorded allocations.",
      "html": "<label class=\"ds-search\"><span class=\"ds-search-label\">Search holders</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" placeholder=\"Search…\" autocomplete=\"off\"></label>",
      "css": ".ds-search{position:relative;display:block;color:var(--muted,#a6b3c6);font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif)}.ds-search-label{display:block;font-size:15px;margin-bottom:8px}.ds-search>svg{position:absolute;left:12px;bottom:13px;pointer-events:none}.ds-search input{width:100%;min-height:44px;padding:8px 12px 8px 40px;border:1px solid var(--border-control,#61748e);border-radius:8px;background:var(--input,#0d1420);color:var(--foreground,#eef2f8);font-family:var(--font-ui,'Manrope Variable','Manrope',sans-serif);font-size:15px}.ds-search input::placeholder{color:var(--muted,#a6b3c6);opacity:1}.ds-search input:focus-visible{border-color:var(--link,#9fc0ff);outline:1px solid var(--link,#9fc0ff);outline-offset:-1px;box-shadow:none}"
    }
  ],
  "narrative": {
    "northStar": "Settlement Workspace",
    "overview": "BondTrace is an operating issuer and holder application. Deep navy surfaces contain payment records, clear tabular figures and available actions. Inset fields distinguish editable data from the ledger; compact inspectors keep the selected financial object in view. The original open outlined BondTrace lettering is the visual signature.\n\nThe implemented world preserves the owner's dark navy direction, English/Russian switch, full desktop width, single field focus edge and existing exact financial/signing semantics. The product presentation is separate. Product commitments live in [PRODUCT.md](PRODUCT.md); the current replacement brief is [docs/frontend/ECC-REDESIGN.md](docs/frontend/ECC-REDESIGN.md). Earlier light-canvas and Settlement Ledger captures are historical.",
    "keyCharacteristics": [
      "Deep navy canvas, darker navigation and contained tonal records.",
      "Saturated blue commands, light blue links and inset editable fields.",
      "Manrope interface text and financial figures; Plex Mono addresses, code and dedicated clock lines.",
      "Full-width desktop work with bounded financial tracks and responsive inspectors.",
      "Original path-drawn BondTrace lettering and one consistent Lucide icon family."
    ],
    "rules": [
      {
        "name": "The Honest State Rule",
        "body": "Color represents an actual operation or validation state; it never implies production, payment or eligibility without evidence.",
        "section": "colors"
      },
      {
        "name": "The Exact Figures Rule",
        "body": "Format the display without rounding away significant digits or changing raw arithmetic; do not substitute floating-point approximations or abbreviations for settlement values.",
        "section": "typography"
      },
      {
        "name": "The Readable Work Rule",
        "body": "Primary body and labels use the documented working hierarchy; compact metadata must not become the default size for financial tasks.",
        "section": "typography"
      },
      {
        "name": "The Bounded Tracks Rule",
        "body": "Use the available desktop width while keeping related money, dates and identity tracks close enough to scan together.",
        "section": "layout"
      },
      {
        "name": "The Flat Records Rule",
        "body": "Working records use tones and seams; overlay shadow identifies a temporary editing or inspection surface.",
        "section": "elevation"
      },
      {
        "name": "The Single Edge Rule",
        "body": "Text-field focus occupies the existing control edge; do not add a detached second ring.",
        "section": "components"
      },
      {
        "name": "The Account Separation Rule",
        "body": "Account selection uses a viewport-bounded 1000px dialog, intrinsic72px-minimum holder rows, independent desktop panes and persistent header/footer; inspection never grants signing rights.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the available desktop width with bounded internal financial tracks.",
      "Do preserve exact raw values while presenting Manrope tabular financial figures.",
      "Do keep labels, date/time lines, recovery, network and signer scope readable and truthful.",
      "Do reuse the original path-drawn BondTrace lettering and consistent Lucide control icons.",
      "Do preserve keyboard focus, draft recovery, display-timezone semantics and reduced-motion behavior.",
      "Do distinguish an archive with capture time and disabled signing from current chain reads."
    ],
    "donts": [
      "Don't restore the rejected white workspace, pale-blue command fill or fixed desktop content caps.",
      "Don't restore mono financial figures from an earlier design document over the implemented Manrope system.",
      "Don't add a detached second focus ring to text fields.",
      "Don't use decorative blinking or repeated checkmarks as page decoration.",
      "Don't invent balances, customers, institutional endorsements or production claims.",
      "Don't add a judge tour, promotional hero or explanatory presentation to work screens.",
      "Don't relabel saved snapshots or generated concepts as current chain evidence.",
      "Don't replace the existing React/CSS component foundation wholesale without reviewed scope."
    ]
  }
}
